//REGION_VERTEX_SHADER
#version 460 core

layout(location = 0) in vec3 attrib_vertex_Pos;
layout(location = 1) in vec3 attrib_vertex_Nrm;
layout(location = 2) in vec2 attrib_vertex_Tex;

layout(std140, binding = 0) uniform SpaceMatrix {
    mat4 ViewProjMatrix;
};
layout(std430, binding = 1) readonly buffer RegionOffsets {
    vec2 Transform[];
};
out vec2 TexCoord;
out float DifColor;
void main() {
    vec2 offset = Transform[gl_InstanceID + gl_BaseInstance];
    vec3 drawPos = attrib_vertex_Pos + vec3(offset.x, 0.0, offset.y);
    vec3 FrontVec = vec3(0.5773502,0.5773502,0.5773502); 
	DifColor = clamp(dot( attrib_vertex_Nrm, FrontVec ), 0.25, 0.93); // Учитываем матрицу модели
    TexCoord = attrib_vertex_Tex;
    gl_Position = ViewProjMatrix * vec4(drawPos, 1.0);
}