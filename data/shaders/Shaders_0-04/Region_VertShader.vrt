//REGION_VERTEX_SHADER
#version 460 core

layout(location = 0) in vec2 attrib_vertex_Pos;
layout(location = 1) in vec2 attrib_vertex_Tex;

uniform sampler2DArray uHeightMapArray;

layout(std140, binding = 0) uniform SpaceMatrix {
    mat4 ViewProjMatrix;
};
layout(std430, binding = 1) readonly buffer RegionOffsets {
    vec2 Transform[];
};
out vec2  TexCoord;
out float DifColor;
void main() {
    vec2 XYpos = attrib_vertex_Pos + Transform[gl_InstanceID + gl_BaseInstance];
	vec2 TexPos = XYpos/512.0f;
    vec3 FrontVec = vec3(0.5773502,0.5773502,0.5773502);
    vec3 ZetUpVec = vec3(0.0, 1.0, 0.0);
	float vHeight = texture(uHeightMapArray, vec3(TexPos, (TexPos.x * 3.0f) + TexPos.y)).g * 24.0f;
	DifColor = clamp(dot( ZetUpVec, FrontVec ), 0.25, 0.93); // Учитываем матрицу модели
    TexCoord = attrib_vertex_Tex;
    gl_Position = ViewProjMatrix * vec4(XYpos.x, vHeight, XYpos.y, 1.0);
}